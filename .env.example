# Dominio público de la aplicación (usado por Traefik y como base de la API)
APP_HOST=comfy-chair.lifia.info.unlp.edu.ar

# Puerto interno del contenedor del frontend (por defecto 8080)
# FRONTEND_PORT=8080

# Fechas de bidding / revisión (opcionales, se inyectan en el build)
# VITE_BIDDING_START=
# VITE_BIDDING_END=
# VITE_REVIEW_START=
# VITE_REVIEW_END=

# Traefik (opcional, valores por defecto)
# TRAEFIK_ENTRYPOINT_HTTP=web
# TRAEFIK_ENTRYPOINT_HTTPS=websecure
# TRAEFIK_CERTRESOLVER=myresolver
